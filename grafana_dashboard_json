                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "count(\n  max_over_time(\n    (\n      100 *\n      sum by (namespace, pod, container) (\n        container_memory_working_set_bytes{\n          namespace=~\"${namespace:regex}\",\n          container=~\"${container:regex}\",\n          container!=\"\",\n          image!=\"\"\n        }\n      )\n      /\n      sum by (namespace, pod, container) (\n        kube_pod_container_resource_limits{\n          namespace=~\"${namespace:regex}\",\n          container=~\"${container:regex}\",\n          resource=\"memory\",\n          unit=\"byte\"\n        } > 0\n      )\n    )[7d:5m] @ end()\n  ) > 80\n)",
                        "instant": true,
                        "legendFormat": "Pods exceeding 80%",
                        "range": false
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
