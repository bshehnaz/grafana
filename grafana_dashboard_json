          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "(\n  100 *\n  sum by (namespace, pod, container) (\n    container_memory_working_set_bytes{\n      namespace=~\"${namespace:regex}\",\n      container=~\"${container:regex}\",\n      container!=\"\",\n      image!=\"\"\n    }\n  )\n  /\n  sum by (namespace, pod, container) (\n    kube_pod_container_resource_limits{\n      namespace=~\"${namespace:regex}\",\n      container=~\"${container:regex}\",\n      resource=\"memory\",\n      unit=\"byte\"\n    } > 0\n  )\n)\nand on (namespace, pod, container)\n(\n  max_over_time(\n    (\n      100 *\n      sum by (namespace, pod, container) (\n        container_memory_working_set_bytes{\n          namespace=~\"${namespace:regex}\",\n          container=~\"${container:regex}\",\n          container!=\"\",\n          image!=\"\"\n        }\n      )\n      /\n      sum by (namespace, pod, container) (\n        kube_pod_container_resource_limits{\n          namespace=~\"${namespace:regex}\",\n          container=~\"${container:regex}\",\n          resource=\"memory\",\n          unit=\"byte\"\n        } > 0\n      )\n    )[7d:5m] @ end()\n  ) > 80\n)",
                        "format": "time_series",
                        "instant": false,
                        "interval": "",
                        "legendFormat": "{{namespace}} / {{pod}}",
                        "range": true
